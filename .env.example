# ---- Local stdio use ----
# Leave both unset to store the login once, outside this repo, for every local MCP host:
#   %USERPROFILE%\.google-workspace-mcp\secrets\credentials.json
#   %USERPROFILE%\.google-workspace-mcp\token.json
# On macOS or Linux those are under $HOME/.google-workspace-mcp/.
# Set absolute paths only to override. Do not commit the real .env.

# GOOGLE_OAUTH_CREDENTIALS_PATH=/ABSOLUTE/PATH/TO/credentials.json
# GOOGLE_OAUTH_TOKEN_PATH=/ABSOLUTE/USER-PRIVATE/PATH/google-workspace-mcp-token.json

# ---- Hosted HTTP use (Railway: set these in the Variables tab, not in a file) ----
# Required by `npm run start:http`. At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MCP_AUTH_TOKEN=

# Google login as environment variables (set all three, or none).
# client_id / client_secret come from the Desktop OAuth client JSON ("installed" section);
# refresh_token comes from token.json after running `npm run auth` on your own machine.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Railway sets PORT itself. Only set it for local HTTP testing.
# PORT=3000
